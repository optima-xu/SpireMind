# Copy this file to .env and fill only the provider you use.
# Never commit .env.

# Generic OpenAI-compatible provider
OPENAI_API_KEY=

# Alibaba Cloud Model Studio / DashScope compatible endpoint
DASHSCOPE_API_KEY=

# Optional overrides for config.local.toml
# SPIREMIND_MODEL=your-model-id
# SPIREMIND_BASE_URL=https://api.openai.com/v1
# SPIREMIND_API_KEY_ENV=OPENAI_API_KEY
